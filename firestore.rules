rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Top-level Catalogs are read-only to all authenticated users
    match /shopItems/{itemId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    match /themes/{themeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    match /achievementDefinitions/{achievementId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // Users can only access and update their own document profile
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null 
                    && request.auth.uid == userId
                    && request.resource.data.xp >= 0 
                    && request.resource.data.coins >= 0
                    && request.resource.data.level >= 1;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Scoped subcollections (habits, logs, water, sleep, mood, focus, etc.)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
